{
  "$schema": "https://uniwire.sh/schema/v1/uniwire.schema.json", "uniwire": "1.0.0",
  "profiles": ["iec60364"],
  "meta": {
    "title": "Machining workshop: energy metering with CTs, power meters and Modbus gateway", "project": "EX-33",
    "client": "Example Precision Machining", "author": "uniwire examples", "lang": "en",
    "notes": [
      "Demonstrates: instrument transformers in the power tree, power meters as auxiliary devices fed by 'measure' links, DIN-rail sub-meters in series, Modbus 'data' links to a gateway; TN-C main distribution (PEN feeders ≥ 10 mm²) with a TN-S sub-board",
      "CT secondaries: 2.5 mm² Cu, shorting terminal blocks before each meter; RS-485 chain P0-P6 → gateway -A0",
      "No RCD on TN-C circuits (PEN); 30 mA protection only on the TN-S sub-board"
    ]
  },
  "installation": {
    "earthing": "TN-C", "system": "3P+N", "un_V": 400, "uln_V": 230, "f_Hz": 50, "ik3_kA": 15,
    "supply": "Customer substation 400 kVA (shared site)", "standard": "IEC 60364"
  },
  "templates": {
    "MC": {
      "type": "breaker", "icu_kA": 36, "poles": "3P", "trip_unit": "TM-D",
      "product": {"manufacturer": "Schneider Electric", "range": "ComPacT NSXm"}
    },
    "SUB": {
      "type": "meter", "kind": "kWh Modbus", "in_A": 63,
      "product": {"manufacturer": "Schneider Electric", "range": "Acti9 iEM3000"}
    }
  },
