  "meta": {
    "title": "Medical centre: standby generator, automatic transfer switch and load shedding", "project": "EX-27",
    "client": "Example Medical Centre", "author": "uniwire examples", "lang": "en",
    "notes": [
      "Demonstrates: generator as second source on a 4-pole ATS ('transfer' link), essential board with priority classes, load-shedding contactors and generator start signal driven by the ATS controller",
      "On mains failure: ATS controller starts the genset, transfers after 10 s, then restores shed loads in steps of 30 s while genset load < 80 %",
      "4-pole ATS switches the neutral: genset neutral earthed at the generator (separately derived source)"
    ]
  },
