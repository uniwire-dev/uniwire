 "meta": {
  "title": "Packaging line control panel CP-100: Modicon M241 with EtherNet/IP remote I/O",
  "project": "EX-44",
  "client": "Example packaging plant",
  "author": "uniwire examples",
  
  "lang": "en",
  "notes": [
   "Demonstrates: 480Y/277 V 60 Hz industrial control panel, class J fused main disconnect, 480/120 V control power transformer, 24 V DC supply, Modicon M241 with onboard I/O + TM3 expansion bus, TM3 EtherNet/IP remote I/O station (data link), VFDs commanded from DO channels and speed references from AO channels (ports)",
   "Panel SCCR 65 kA; motor FLA per NEC table 430.250 (5 HP = 7.6 A, 3 HP = 4.8 A at 460 V)",
   "Slot 0 = onboard outputs (10 DO 24 V DC transistor)"
  ]
 },
