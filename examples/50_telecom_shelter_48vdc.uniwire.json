 "meta": {
  "title": "Example telecom shelter: -48 V DC power plant with battery backup and genset inlet",
  "project": "EX-50",
  "client": "Example tower company",
  "author": "uniwire examples",
  
  "lang": "en",
  "notes": [
   "Demonstrates: -48 V DC rectifier plant (3 x 3 kW modules, N+1, positive pole earthed), two VRLA battery strings on fuse-switches, low-voltage disconnect separating priority and non-priority DC loads, manual transfer switch with mobile genset inlet ('transfer' link), monitoring controller (data link)",
   "Battery: 2 strings x 190 Ah at 48 V ≈ 18 kWh → ~4 h autonomy at 3.5 kW DC load; LVD opens non-priority loads at 46 V, priority loads kept to 43.2 V",
   "DC breakers single-pole on the -48 V conductor; return (+) conductor bonded to the shelter main earth bar"
  ]
 },
