              {"type": "breaker", "ref": "-Q25", "use": "C20", "phase": "L2", "cable": {"cores": "3G", "section_mm2": 2.5},
               "children": [{"type": "appliance", "kind": "washing_machine", "label": "Lave-linge", "p_kW": 2.2}]},
              {"type": "breaker", "ref": "-Q26", "use": "C20", "phase": "L3", "cable": {"cores": "3G", "section_mm2": 2.5},
               "children": [{"type": "appliance", "kind": "dryer", "label": "Sèche-linge", "p_kW": 2.5}]}
            ]},
            {"type": "rcd", "ref": "-F3", "use": "ID4P", "in_A": 63, "rcd_type": "A", "label": "ID3 chauffage/ECS", "children": [
              {"type": "breaker", "ref": "-Q31", "in_A": 16, "curve": "C", "icn_kA": 4.5, "poles": "4P",
               "cable": {"cores": "5G", "section_mm2": 2.5, "length_m": 12},
