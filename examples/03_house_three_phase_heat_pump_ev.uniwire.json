                    {"type": "breaker", "ref": "-Q12", "use": "C20", "phase": "L1", "cable": {"cores": "3G", "section_mm2": 2.5},
                     "children": [{"type": "socket", "label": "Prises ch. 1-2", "points": 10}]},
                    {"type": "breaker", "ref": "-Q13", "use": "C20", "phase": "L1", "cable": {"cores": "3G", "section_mm2": 2.5},
                     "children": [{"type": "socket", "label": "Prises ch. 3-4", "points": 10}]},
                    {"type": "breaker", "ref": "-Q14", "use": "C16", "phase": "L1", "cable": {"cores": "3G", "section_mm2": 1.5},
                     "children": [{"type": "shutter", "label": "Volets étage", "count": 5, "p_kW": 0.5}]}
                  ]},
                  {"type": "rcd", "ref": "-F2", "use": "ID2P", "rcd_type": "A", "label": "ID salles d'eau", "children": [
                    {"type": "breaker", "ref": "-Q21", "use": "C16", "phase": "L2", "cable": {"cores": "3G", "section_mm2": 1.5},
                     "children": [{"type": "lighting", "label": "Éclairage SdB/couloir", "points": 6}]},
                    {"type": "breaker", "ref": "-Q22", "use": "C20", "phase": "L2", "cable": {"cores": "3G", "section_mm2": 2.5},
                     "children": [{"type": "socket", "label": "Prises SdB/couloir", "points": 5}]},
                    {"type": "breaker", "ref": "-Q23", "use": "C16", "phase": "L2", "cable": {"cores": "3G", "section_mm2": 1.5},
                     "children": [{"type": "heating", "label": "Sèche-serviettes", "p_kW": 1.5, "count": 2, "pilot_wire": true}]}
                  ]}
                ]}
              ]}
            ]},
            {"type": "rcd", "ref": "-F5", "use": "ID2P", "rcd_type": "A", "label": "ID IRVE", "children": [
              {"type": "breaker", "ref": "-Q51", "use": "C32", "in_A": 40, "phase": "L3", "cable": {"designation": "U1000R2V", "cores": "3G", "section_mm2": 10, "length_m": 15},
               "children": [{"id": "IRVE", "type": "ev_charger", "label": "Borne 7,4 kW", "mode": "3", "p_kW": 7.4, "location": "Carport",
                             "product": {"description": "Borne murale 32 A mono T2S, RDC-DD intégré"}}]}
            ]},
            {"type": "breaker", "ref": "-Q6", "label": "Déconnexion parafoudre", "in_A": 20, "curve": "C", "icn_kA": 4.5, "poles": "4P", "children": [
              {"type": "spd", "ref": "-F6", "label": "Parafoudre", "spd_type": "2", "imax_kA": 40, "in_kA": 15, "up_kV": 1.5, "uc_V": 275, "poles": "3P+N"}
            ]}
