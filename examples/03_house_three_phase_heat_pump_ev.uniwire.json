{
  "$schema": "https://uniwire.sh/schema/v1/uniwire.schema.json",
  "uniwire": "1.0.0",
  "profiles": ["nfc15100", "enedis"],
  "meta": {
    "lang": "fr",
    "title": "Grande maison triphasée : PAC air/eau et borne de recharge",
    "project": "EX-03",
    "client": "Exemple de maison 180 m² sur deux niveaux",
    "author": "uniwire examples",
    
    "drawing_number": "EX-03-SLD-01",
    "notes": [
      "Démontre : branchement triphasé 3P+N 400 V, équilibrage des phases (colonne Phase), tableau divisionnaire d'étage sur folio séparé (own_sheet), pompe à chaleur triphasée, IRVE mode 3 7,4 kW sur circuit dédié",
      "Borne de recharge avec détection 6 mA DC intégrée (RDC-DD, IEC 62955) : interrupteur différentiel amont type A admis",
      "Parafoudre type 2 obligatoire (IRVE + zone AQ2)"
    ]
  },
  "installation": {
    "earthing": "TT", "system": "3P+N", "un_V": 400, "uln_V": 230, "f_Hz": 50,
    "supply": "Tarif Bleu", "subscribed_kVA": 24, "earth_resistance_ohm": 28,
    "surface_m2": 180, "standard": "NF C 15-100"
  },
  "templates": {
    "C2": {"type": "breaker", "in_A": 2, "curve": "C", "icn_kA": 4.5, "poles": "1P+N"},
    "C10": {"type": "breaker", "in_A": 10, "curve": "C", "icn_kA": 4.5, "poles": "1P+N"},
    "C16": {"type": "breaker", "in_A": 16, "curve": "C", "icn_kA": 4.5, "poles": "1P+N"},
    "C20": {"type": "breaker", "in_A": 20, "curve": "C", "icn_kA": 4.5, "poles": "1P+N"},
    "C32": {"type": "breaker", "in_A": 32, "curve": "C", "icn_kA": 4.5, "poles": "1P+N"},
    "ID4P": {"type": "rcd", "in_A": 40, "idn_mA": 30, "poles": "4P",
             "product": {"manufacturer": "Hager", "description": "Interrupteur différentiel 4P 40 A 30 mA"}},
    "ID2P": {"type": "rcd", "in_A": 40, "idn_mA": 30, "poles": "2P",
             "product": {"manufacturer": "Hager", "description": "Interrupteur différentiel 2P 40 A 30 mA"}}
  },
  "sources": [
    {"type": "grid", "label": "Réseau public", "supply": "Tarif Bleu", "un_V": 400, "children": [
