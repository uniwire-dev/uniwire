 "meta": {
  "title": "Example House: hybrid inverter, battery and protected loads panel (120/240 V)",
  "project": "EX-39",
  "client": "Example House",
  "author": "uniwire examples",
  
  "lang": "en",
  "notes": [
   "Demonstrates: North American split-phase 120/240 V 60 Hz service, DC-coupled hybrid inverter with PV (module-level rapid shutdown) and battery, protected (backup) loads subpanel fed from the inverter backup port, AWG sizes and raceways, GFCI/AFCI breakers, service CTs (measure link)",
   "Hybrid inverter 11.4 kW: 47.5 A continuous x 1.25 = 59.4 A → 60 A 2-pole backfeed breaker, #6 AWG Cu THHN; 200 A busbar / 200 A main: 120 % rule allows 40 A of backfeed, so the main breaker is derated to 175 A",
   "Rapid shutdown per module (MLPE); PV disconnect integrated in the inverter"
  ]
 },
 "installation": {
  "earthing": "TN-C-S",
  "system": "split-phase",
  "un_V": 240,
  "uln_V": 120,
  "f_Hz": 60,
  "supply": "Utility overhead service 200 A",
  "ik3_kA": 10,
  "standard": "NEC 2023 (informative)"
 },
