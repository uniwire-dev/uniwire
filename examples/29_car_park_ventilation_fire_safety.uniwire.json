{
  "$schema": "https://uniwire.sh/schema/v1/uniwire.schema.json", "uniwire": "1.0.0",
  "profiles": ["iec60364"],
  "meta": {
    "title": "Underground car park (3 levels, 420 spaces): ventilation, smoke control and fire-safety supplies",
    "project": "EX-29", "client": "Example Car Park", "author": "uniwire examples", "lang": "en",
    "notes": [
      "Demonstrates: fire-safety supplies taken upstream of the main switch, secondary safety source (genset) on the smoke-control board, fire-resistant cables (cpr_class), priority 'safety', VFDs in fire mode, control links from CO detection and fire alarm",
      "Fire mode: VFD protections inhibited, fans run at 100 % until destroyed (F300 rated, 2 h)",
      "Safety circuits: no RCD; breakers chosen for full discrimination with the upstream fire-services breaker -QF"
    ]
  },
  "installation": {
    "earthing": "TN-S", "system": "3P+N", "un_V": 400, "uln_V": 230, "f_Hz": 50, "ik3_kA": 25,
    "standard": "IEC 60364-5-56 / EN 12101-3"
  },
  "templates": {
    "SAF": {
      "type": "breaker", "icu_kA": 36, "poles": "3P", "lockable": true,
      "product": {"manufacturer": "Eaton", "range": "NZM"}
    },
    "MCB": {"type": "breaker", "curve": "C", "icn_kA": 15, "product": {"manufacturer": "Eaton", "range": "FAZ"}}
  },
