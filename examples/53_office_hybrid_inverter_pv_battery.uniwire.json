     "children": [
      {"type": "spd", "id": "FS1", "ref": "-FS1", "spd_type": "2", "imax_kA": 40},
      {"type": "pv_array", "ref": "PV1", "label": "South roof", "modules": 9, "module_W": 420, "p_kW": 3.8}
     ]
    },
    {
     "type": "switch_disconnector",
     "id": "QS2",
