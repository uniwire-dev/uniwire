{
 "$schema": "https://uniwire.sh/schema/v1/uniwire.schema.json",
 "uniwire": "1.0.0",
 "meta": {
  "title": "Example office: hybrid inverter with rooftop PV, battery and essential loads board",
  "project": "EX-53",
  "client": "Example Office",
  "author": "uniwire examples",
  "lang": "en",
  "notes": [
   "Demonstrates: hybrid inverter drawn as a source of its own, AC input fed from the main board through an 'infeed' link, DC side with two PV strings (each with its disconnector and surge protector) and a battery, an essential loads board on the backup output, an export-limiting CT (measure link) and a narrow rooftop enclosure with a long label",
   "The inverter takes its AC input from -Q3 of the main board and backs up the essential loads board when the grid fails",
   "String disconnectors and DC surge protectors in a rooftop enclosure next to the array"
  ]
 },
 "installation": {
  "earthing": "TN-S",
  "system": "3P+N",
  "un_V": 400,
  "uln_V": 230,
  "f_Hz": 50,
  "supply": "Public LV network 63 A",
  "ik3_kA": 6,
  "standard": "IEC 60364-7-712 (informative)"
 },
 "sources": [
  {
   "type": "grid",
   "label": "LV network",
   "children": [
    {
     "type": "meter",
