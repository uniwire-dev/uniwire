             "rcd_type": "A",
             "poles": "1P+N",
             "phase": "L1",
             "cable": {"cores": "3G", "section_mm2": 6, "length_m": 8}
            },
            {
             "type": "rcd",
             "ref": "-F1",
             "label": "Offices",
             "in_A": 40,
             "idn_mA": 30,
             "rcd_type": "A",
             "poles": "4P",
             "children": [
              {
               "type": "breaker",
               "ref": "-Q11",
               "in_A": 10,
               "curve": "C",
               "poles": "1P+N",
               "phase": "L2",
               "children": [{"type": "lighting", "label": "Open-plan lighting", "points": 14}]
              },
              {
               "type": "breaker",
               "ref": "-Q12",
               "in_A": 16,
               "curve": "C",
               "poles": "1P+N",
               "phase": "L3",
               "children": [{"type": "socket", "label": "Desk sockets", "points": 8}]
              },
              {
               "type": "breaker",
               "ref": "-Q13",
               "in_A": 16,
               "curve": "C",
               "poles": "1P+N",
               "phase": "L2",
               "children": [{"type": "spare", "label": "Spare"}]
              }
             ]
            },
            {
             "type": "breaker",
             "ref": "-Q20",
             "label": "Air conditioning",
             "in_A": 20,
             "curve": "C",
             "poles": "3P+N",
             "children": [{"type": "ventilation", "label": "Split air conditioning", "p_kW": 7.5}]
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  },
  {
