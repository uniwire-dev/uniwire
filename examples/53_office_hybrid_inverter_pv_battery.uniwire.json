         "curve": "C",
         "idn_mA": 30,
         "rcd_type": "A",
         "children": [{"type": "socket", "label": "Server rack", "points": 2}]
        },
        {
         "type": "rcbo",
         "ref": "-Q42",
         "in_A": 10,
         "curve": "C",
         "idn_mA": 30,
         "rcd_type": "A",
         "children": [{"type": "lighting", "label": "Emergency lighting", "points": 6}]
        },
        {
         "type": "rcbo",
         "ref": "-Q43",
         "in_A": 16,
         "curve": "C",
         "idn_mA": 30,
         "rcd_type": "A",
         "children": [{"type": "appliance", "label": "Kitchen fridge", "kind": "fridge"}]
        }
       ]
      }
     ]
    }
   ]
  }
 ],
 "links": [
  {"id": "L_IN", "kind": "infeed", "from": "QINV", "to": "INV", "label": "W3 AC input"},
  {"id": "L_CT", "kind": "measure", "from": "MTR", "to": "INV", "label": "Export limiting CT"}
 ],
 "enclosures": [
  {"id": "E_ROOF", "ref": "+R1", "label": "Rooftop DC isolator enclosure", "kind": "box", "nodes": ["QS1", "FS1"]}
 ],
