     ]
    },
    {
     "type": "breaker",
     "ref": "-Q4",
     "label": "Backup output",
     "in_A": 32,
     "curve": "C",
     "poles": "1P+N",
     "cable": {"cores": "3G", "section_mm2": 6, "length_m": 4},
     "children": [
      {
       "type": "board",
       "id": "EDB",
       "ref": "EDB",
       "label": "Essential loads board",
       "system": "1P+N",
       "children": [
