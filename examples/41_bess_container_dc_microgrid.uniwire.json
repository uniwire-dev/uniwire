 "meta": {
  "title": "Battery storage container 250 kW / 500 kWh with 380 V DC microgrid",
  "project": "EX-41",
  "client": "Example business park",
  "author": "uniwire examples",
  
  "lang": "en",
  "notes": [
   "Demonstrates: BESS container with AC panel, bidirectional PCS, unearthed (IT) 768 V DC bus with insulation monitor, rack fuse-switches, DC/DC converter feeding a 380 V DC microgrid (DC EV charger, DC lighting, IT racks), auxiliaries panel with HVAC and fire suppression, EMS data links",
   "4 racks x 125 kWh LFP, 768 V nominal (672-864 V); 0.5C → 81 A per rack, aR 160 A fuses; PCS DC input 2x(1x185) per pole",
   "DC microgrid 380 V: unearthed, mid-point monitored by the PCS IMD; 2-pole DC breakers"
  ]
 },
 "installation": {
  "earthing": "TN-S",
  "system": "3P+N",
  "un_V": 400,
  "uln_V": 230,
  "f_Hz": 50,
