                  {"type": "rcd", "ref": "-F4", "use": "RCD40A", "label": "RCCB wallbox", "children": [
                    {"type": "breaker", "ref": "-F41", "use": "B16_3", "label": "Wallbox",
                     "cable": {"ref": "W41", "designation": "NYY-J", "cores": "5x", "section_mm2": 4, "material": "Cu", "length_m": 22, "install": "C", "insulation": "PVC"},
                     "children": [{"type": "ev_charger", "label": "Wallbox 11 kW", "mode": "3", "p_kW": 11, "location": "Garage",
