                     "children": [{"type": "lighting", "label": "Lighting UF", "points": 9}]},
                    {"type": "breaker", "ref": "-F22", "use": "B16", "phase": "L3", "cable": {"ref": "W22", "designation": "NYM-J", "cores": "3x", "section_mm2": 1.5},
                     "children": [{"type": "socket", "label": "Sockets bedrooms", "points": 12}]},
                    {"type": "breaker", "ref": "-F23", "use": "B16", "phase": "L1", "cable": {"ref": "W23", "designation": "NYM-J", "cores": "3x", "section_mm2": 1.5},
                     "children": [{"type": "socket", "label": "Sockets bathroom", "points": 3}]},
                    {"type": "breaker", "ref": "-F24", "use": "B16", "phase": "L2", "cable": {"ref": "W24", "designation": "NYM-J", "cores": "3x", "section_mm2": 2.5},
                     "children": [{"type": "appliance", "kind": "washing_machine", "label": "Washing machine", "p_kW": 2.2}]},
                    {"type": "breaker", "ref": "-F25", "use": "B16", "phase": "L3", "cable": {"ref": "W25", "designation": "NYM-J", "cores": "3x", "section_mm2": 2.5},
                     "children": [{"type": "appliance", "kind": "dryer", "label": "Tumble dryer (heat pump)", "p_kW": 0.9}]},
                    {"type": "breaker", "ref": "-F26", "use": "B16", "phase": "L1", "cable": {"ref": "W26", "designation": "NYM-J", "cores": "3x", "section_mm2": 1.5},
