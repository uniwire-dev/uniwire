{
  "$schema": "https://uniwire.sh/schema/v1/uniwire.schema.json",
  "uniwire": "1.0.0",
  "profiles": ["iec60364"],
  "meta": {
    "lang": "en",
    "title": "Single-family house (Germany): meter cabinet and distribution board",
    "project": "EX-06",
    "client": "Example House (DE)",
    "author": "uniwire examples",
    
    "notes": [
      "Demonstrates: German-style TN-C-S house with service fuses (NH00) in the house connection box, bidirectional meter, selective main circuit breaker (SLS, E characteristic), combined Type 1+2 SPD, 3-phase cooker and instantaneous water heater, 11 kW wallbox, 9.8 kWp rooftop PV",
      "PEN split at the main earthing terminal in the meter cabinet; foundation earth electrode",
      "Instantaneous water heater: fixed 3-phase equipment, fault protection by automatic disconnection (TN), no RCD required"
    ]
  },
  "installation": {
    "earthing": "TN-C-S", "system": "3P+N", "un_V": 400, "uln_V": 230, "f_Hz": 50,
    "supply": "Low-voltage house connection 63 A", "ik3_kA": 6, "standard": "DIN VDE 0100 / VDE-AR-N 4100"
  },
  "templates": {
    "B10": {"type": "breaker", "in_A": 10, "curve": "B", "icn_kA": 6, "poles": "1P",
            "product": {"manufacturer": "Siemens", "part_number": "5SY6110-6", "range": "5SY", "description": "MCB 1P B10 6 kA"}},
    "B16": {"type": "breaker", "in_A": 16, "curve": "B", "icn_kA": 6, "poles": "1P",
            "product": {"manufacturer": "Siemens", "part_number": "5SY6116-6", "range": "5SY", "description": "MCB 1P B16 6 kA"}},
    "B16_3": {"type": "breaker", "in_A": 16, "curve": "B", "icn_kA": 6, "poles": "3P",
              "product": {"manufacturer": "Siemens", "part_number": "5SY6316-6", "range": "5SY", "description": "MCB 3P B16 6 kA"}},
    "RCD40A": {"type": "rcd", "in_A": 40, "idn_mA": 30, "rcd_type": "A", "poles": "4P",
               "product": {"manufacturer": "Siemens", "range": "5SV", "description": "RCCB 4P 40 A 30 mA type A"}}
  },
