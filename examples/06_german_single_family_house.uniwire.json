                   "cable": {"ref": "W5", "designation": "NYM-J", "cores": "5x", "section_mm2": 4, "material": "Cu", "length_m": 9, "install": "C", "insulation": "PVC"},
                   "children": [
                    {"type": "inverter", "ref": "-T1", "label": "PV inverter", "kind": "string", "p_kVA": 8, "mppt": 2, "protection": "VDE-AR-N 4105", "children": [
                      {"type": "switch_disconnector", "ref": "-Q51", "label": "DC isolator", "in_A": 25, "dc": true, "poles": "2P", "children": [
                        {"type": "pv_array", "label": "Roof PV 9.8 kWp", "modules": 24, "module_W": 410, "strings": 2, "p_kW": 9.84, "voc_V": 448, "isc_A": 13.8,
                         "cable": {"ref": "W51", "designation": "H1Z2Z2-K", "cores": "2x", "section_mm2": 6, "length_m": 25}}
                      ]}
                    ]}
                  ]},
                  {"type": "spd", "id": "SPD1", "ref": "-F6", "label": "Combined SPD", "spd_type": "1+2", "imax_kA": 50, "in_kA": 12.5, "up_kV": 1.5, "uc_V": 264, "poles": "3P+N"}
