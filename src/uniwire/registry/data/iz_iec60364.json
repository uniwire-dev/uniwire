{
 "header": {
  "title": "Current-carrying capacities Iz (A) of LV cables at the reference conditions of IEC 60364-5-52, as formulas",
  "source": "IEC 60364-5-52",
  "formula": "Iz = a * S^m, S the cross-section in mm2, one (a, m) per column and per range of sections: up to 16 mm2, and from 25 mm2. Between 16 and 25 mm2, the lower of the two. The formulas never give more than the values of the standard.",
  "reference_conditions": {
   "air_C": 30,
   "ground_C": 20,
   "soil_thermal_resistivity_Km_per_W": 2.5,
   "depth_m": 0.7
  },
  "temperature": "Other ambients: Iz * sqrt((theta_max - theta) / (theta_max - theta_ref)), theta_max 70 C for PVC and 90 C for XLPE/EPR, theta_ref the reference above. Used from 10 C (lower ambients are taken as 10 C) up to 60 C for PVC and 80 C for XLPE.",
  "methods": {
   "A1": "insulated conductors in conduit in a thermally insulating wall",
   "A2": "multicore cable in conduit in a thermally insulating wall",
   "B1": "insulated conductors in conduit on a wall",
   "B2": "multicore cable in conduit on a wall",
   "C": "single or multicore cable on a wall",
   "D1": "multicore cable in a duct in the ground",
   "D2": "cable buried directly in the ground",
   "E": "multicore cable in free air (perforated tray, ladder)",
   "F": "single-core cables in free air, touching: two for 2 loaded conductors; for 3, the lower of trefoil and flat"
  },
  "keys": "pieces[method][insulation][material][loaded_conductors] -> [[S_min, S_max, a, m], ...]; insulation XLPE covers EPR; a combination the tables do not give has no entry."
